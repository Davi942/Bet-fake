# Optional: docker compose up works with these defaults without copying this file.
# Host HTTP port. Container HTTP port is always 3000.
APP_PORT=3000
POSTGRES_DB=bet_fake
POSTGRES_USER=bet_fake
POSTGRES_PASSWORD=local-demo-password
# Used only when creating the demonstration accounts for the first time.
DEMO_ADMIN_PASSWORD=AdminDemo123!
DEMO_BETTOR_PASSWORD=ApostadorDemo123!
# Optional direct execution outside Compose (not needed for normal startup).
# Compose provides these automatically. A host PostgreSQL connection is needed.
# PORT=3000
# NODE_ENV=production
# PGHOST=localhost
# PGPORT=5432
# PGDATABASE=bet_fake
# PGUSER=bet_fake
# PGPASSWORD=local-demo-password
# Override the running application URL used by npm test.
# TEST_BASE_URL=http://localhost:3000
